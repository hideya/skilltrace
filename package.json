{
  "name": "skilltrace",
  "version": "0.3.3",
  "description": "Local observability for AI agent skill usage",
  "keywords": [
    "agent",
    "agent-skills",
    "ai-agent",
    "codex",
    "mcp",
    "observability",
    "skill",
    "skilltrace",
    "tracing"
  ],
  "homepage": "https://github.com/hideya/skilltrace#readme",
  "bugs": {
    "url": "https://github.com/hideya/skilltrace/issues"
  },
  "license": "MIT",
  "author": "hideya kawahara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideya/skilltrace.git"
  },
  "bin": {
    "skilltrace": "./bin/skilltrace.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "bin",
    "build",
    "dist",
    "scripts/templates",
    "react-router.config.ts"
  ],
  "type": "module",
  "scripts": {
    "prep": "node scripts/prep.js",
    "dev": "react-router dev --host 0.0.0.0 --port 5777 --strictPort",
    "build": "react-router build && node scripts/build-package-scripts.js",
    "prepack": "pnpm build",
    "publish:test": "pnpm clean && pnpm install && npm publish --access=public --dry-run",
    "publish:do": "pnpm clean && pnpm install && npm publish --access=public",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "skilltrace:read": "tsx scripts/skilltrace-read.ts",
    "skilltrace:log": "tsx scripts/skilltrace-log.ts",
    "skilltrace:demo": "tsx scripts/skilltrace-demo.ts",
    "skilltrace:mcp": "tsx scripts/skilltrace-mcp.ts",
    "skilltrace:install": "tsx scripts/install-traceskill-bin.ts install",
    "skilltrace:uninstall": "tsx scripts/install-traceskill-bin.ts uninstall",
    "skilltrace:kill-5777": "lsof -t -i:5777 | xargs -r kill",
    "skilltrace:kill-probe": "tsx scripts/kill-shared-probes.ts",
    "skilltrace": "tsx scripts/traceskill.ts",
    "skilltrace-dev": "SKILLTRACE_DEV=1 SKILLTRACE_SERVER=http://localhost:5777 PORT=5777 tsx scripts/traceskill.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "atlas": "atlas schema apply --env dev",
    "atlas:prod": "dotenv -- atlas schema apply --env prod",
    "db:init-local": "tsx scripts/init-local-db.ts",
    "db:pull": "tsx scripts/sync-turso-to-local-db.ts",
    "db:push": "tsx scripts/sync-local-db-to-turso.ts",
    "drizzle-studio": "pnpm drizzle-kit studio",
    "drizzle-studio:prod": "NODE_ENV=production dotenv -- pnpm drizzle-kit studio",
    "ship": "node scripts/ship.js",
    "clean": "node scripts/clean.js -e .env -e data -e tmp"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-router/node": "^7.18.1",
    "acorn": "^8.17.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "es-toolkit": "^1.49.0",
    "isbot": "^5",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^8.0.11",
    "qs": "^6.15.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "remix-toast": "^4.0.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.6.16",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.45.0",
    "react-router-auto-routes": "^0.8.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
