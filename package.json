{
  "name": "skilltrace",
  "version": "0.0.0",
  "license": "MIT",
  "bin": {
    "traceskill": "./bin/traceskill.js"
  },
  "files": [
    "app",
    "bin",
    "build",
    "scripts",
    "README.md",
    "react-router.config.ts",
    "routes.ts",
    "vite.config.ts"
  ],
  "type": "module",
  "scripts": {
    "prep": "node scripts/prep.js",
    "dev": "react-router dev --host 0.0.0.0 --port 5777",
    "build": "react-router build",
    "prepack": "pnpm build",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "skilltrace:read": "tsx scripts/skilltrace-read.ts",
    "skilltrace:log": "tsx scripts/skilltrace-log.ts",
    "skilltrace:demo": "tsx scripts/skilltrace-demo.ts",
    "skilltrace:mcp": "tsx scripts/skilltrace-mcp.ts",
    "skilltrace:probe-mcp": "tsx scripts/skilltrace-probe-mcp.ts",
    "skilltrace:probe-session": "tsx scripts/skilltrace-probe-session.ts",
    "traceskill": "tsx scripts/traceskill.ts",
    "traceskill-dev": "SKILLTRACE_SERVER=http://localhost:5777 PORT=5777 tsx scripts/traceskill.ts",
    "traceskill:mcp": "tsx scripts/skilltrace-mcp.ts",
    "traceskill:install": "tsx scripts/install-traceskill-bin.ts install",
    "traceskill:uninstall": "tsx scripts/install-traceskill-bin.ts uninstall",
    "sandbox:reset": "tsx scripts/reset-agent-sandbox.ts",
    "atlas": "atlas schema apply --env dev",
    "atlas:prod": "dotenv -- atlas schema apply --env prod",
    "db:init-local": "tsx scripts/init-local-db.ts",
    "db:pull": "tsx scripts/sync-turso-to-local-db.ts",
    "db:push": "tsx scripts/sync-local-db-to-turso.ts",
    "drizzle-studio": "pnpm drizzle-kit studio",
    "drizzle-studio:prod": "NODE_ENV=production dotenv -- pnpm drizzle-kit studio",
    "ship": "node scripts/ship.js",
    "clean": "node scripts/clean.js -e .env -e /tmp -e /data"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-router/node": "^7.17.0",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "es-toolkit": "^1.47.0",
    "isbot": "^5.1.42",
    "lucide-react": "latest",
    "nanoid": "^5.1.11",
    "nodemailer": "^8.0.10",
    "qs": "^6.15.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.17.0",
    "remix-toast": "^4.0.0",
    "sonner": "^2.0.7",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "^7.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.5.23",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.45.0",
    "react-router-auto-routes": "^0.8.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
