# At least 32 characters
# % openssl rand -base64 48
COOKIE_SECRET=

# App origin (must match OAuth app config)
ORIGIN=http://localhost:5173
# ORIGIN=https://...vercel.app
# Google Cloud Console: https://console.cloud.google.com/auth/clients/
#   Redirect URI: https://...app/oauth/google/callback

# Local DB defaults come from app/config/.server/db.ts in dev mode
# For production deployments, set Turso/libsql values:
DB_URL=
DB_AUTH_TOKEN=

SMTP_CONFIG='{"host":"smtp.gmail.com","port":587,"secure":false,"auth":{"user":"you@gmail.com","pass":"xxxx xxxx xxxx xxxx"}}'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
